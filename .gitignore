# Everything that is not source is in data/: files of the games, extracted assets, work files,
# results, validation pictures and videos, built mods, local tools and the local configuration.
# data/README.md describes the layout.
/data/*
!/data/README.md

__pycache__/
*.pyc
.venv/
target/

# A guard: these are never source. A tool or a person can put one outside data/ by mistake
# (an esx build in mods/NAME, a rig file beside a program). `./port selftest` also looks.
/mods/*/build/
/mods/*/assets/
/mods/*/meshes/
/mods/*/source/
/mods/*/docs/
/mods/*/behavior/*/animations/
/destiny/port/rig/*
!/destiny/port/rig/d2_hands.json
*.hkx
*.hkt
*.nif
*.kf
*.ba2
*.esp
*.esm
*.esl
*.dds
*.bgsm
*.bgem
*.glb
*.gltf
*.dll
*.so
*.exe
*.npz
*.png
*.jpg
*.jpeg
*.tga
*.mp4
*.mkv
*.wav
*.xwm
*.fuz
