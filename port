#!/usr/bin/env python3
"""The one entry point of this repository. `./port help` shows the usage."""
import os
import sys

if sys.version_info < (3, 11):
    sys.exit('port: Python 3.11 or later is necessary. This is Python %d.%d.' % sys.version_info[:2])

sys.dont_write_bytecode = True
sys.path.insert(0, os.path.dirname(os.path.realpath(__file__)))

from portkit import cli  # noqa: E402

sys.exit(cli.main(sys.argv[1:]))
